PORT=5000
ENQUIRIES_PORT=5001
AVAILABILITY_PORT=5002
NOTIFICATIONS_PORT=5003
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
DB_NAME=hospital_backend
JWT_SECRET=replace_with_64_char_hex_secret
JWT_EXPIRES_IN=7d

# Optional: set these when running microservices as separate processes
# AVAILABILITY_SERVICE_URL=http://localhost:5002
# NOTIFICATION_SERVICE_URL=http://localhost:5003
